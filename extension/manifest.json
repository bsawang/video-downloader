{
  "manifest_version": 3,
  "name": "短视频下载器",
  "version": "0.3.8",
  "description": "抖音视频无水印下载（无后端，页面内直接下载）",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/main.v036.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/isolated.v036.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
